# --- Server ---
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# --- Database (matches docker-compose.yml) ---
DATABASE_URL="postgresql://globetrotter:globetrotter@localhost:5432/globetrotter?schema=public"

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Rate limiting ---
AUTH_RATE_LIMIT_MAX=20
SIGNUP_RATE_LIMIT_MAX=10
RESET_RATE_LIMIT_MAX=5

# --- Reverse proxies in front of the app (0 = direct) ---
TRUST_PROXY=0

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# --- Email ---
# Public origin of the frontend; used to build links inside emails.
APP_URL=http://localhost:5173
# smtp = really send | log = print to stdout (local dev) | memory = capture (tests)
MAIL_TRANSPORT=log
MAIL_FROM="GlobeTrotter <no-reply@globetrotter.app>"
# Either SMTP_URL, or the host/port/user/password set below.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

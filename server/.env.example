# --- Server ---
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# --- Database (matches docker-compose.yml) ---
DATABASE_URL="postgresql://globetrotter:globetrotter@localhost:5432/globetrotter?schema=public"

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Rate limiting ---
AUTH_RATE_LIMIT_MAX=20
SIGNUP_RATE_LIMIT_MAX=10
RESET_RATE_LIMIT_MAX=5

# --- Reverse proxies in front of the app (0 = direct) ---
TRUST_PROXY=0

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
